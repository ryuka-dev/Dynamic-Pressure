  <!--
    Drop the built DLL next to the packaging files and, on request, into a Gale
    profile for testing:  dotnet build -c Release -p:DeployToSulfurProfile=true
    Deploy into a profile that does NOT already carry a Thunderstore install of
    this mod - two copies of the same plugin GUID make BepInEx pick one and log
    "Skipping [...]", which turns a clean log into a meaningless one.
  -->
  <Target Name="DeployToGaleProfile" AfterTargets="Build" Condition="'$(DeployToSulfurProfile)' == 'true'">
    <ItemGroup>
      <LangFiles Include="$(ThunderstoreDir)\lang\*.json" />
    </ItemGroup>
    <MakeDir Directories="$(SulfurBepInExPluginsDir)\DynamicPressure" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SulfurBepInExPluginsDir)\DynamicPressure" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ThunderstoreDir)" />
    <Copy SourceFiles="@(LangFiles)" DestinationFolder="$(SulfurBepInExPluginsDir)\DynamicPressure\lang" Condition="'@(LangFiles)' != ''" />
  </Target>
