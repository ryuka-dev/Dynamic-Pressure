{
  "entries": [
    {
      "key": "plugin.name",
      "value": "動的プレッシャー"
    },
    {
      "key": "plugin.description",
      "value": "適応型の敵プレッシャーと任意の動的スポーンを追加します。"
    },
    {
      "key": "section.General",
      "value": "一般"
    },
    {
      "key": "section.Tuning",
      "value": "調整"
    },
    {
      "key": "section.Debug Overlay",
      "value": "デバッグオーバーレイ"
    },
    {
      "key": "entry.General.EnableMod.name",
      "value": "有効化Mod"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "動的プレッシャーのオン/オフを切り替えます。"
    },
    {
      "key": "entry.General.PressureStyle.name",
      "value": "プレッシャースタイル"
    },
    {
      "key": "entry.General.PressureStyle.description",
      "value": "ディレクターのプレッシャーの強さ。上のスタイルほど増援が頻繁に送られ、強い敵が早い段階で登場します。"
    },
    {
      "key": "value.General.PressureStyle.Light",
      "value": "軽量"
    },
    {
      "key": "value.General.PressureStyle.Heavy",
      "value": "重め"
    },
    {
      "key": "value.General.PressureStyle.Nightmare",
      "value": "ナイトメア"
    },
    {
      "key": "entry.General.SpawnPosition.name",
      "value": "スポーン位置"
    },
    {
      "key": "entry.General.SpawnPosition.description",
      "value": "増援の出現場所。バランス: 主に前方と側面で、背後はまれ。前方: 背後には出現しません。どこでも: あらゆる方向から、視界内にも出現します。"
    },
    {
      "key": "value.General.SpawnPosition.Balanced",
      "value": "バランス"
    },
    {
      "key": "value.General.SpawnPosition.Ahead",
      "value": "前方"
    },
    {
      "key": "value.General.SpawnPosition.Anywhere",
      "value": "どこでも"
    },
    {
      "key": "entry.General.RecordCombatData.name",
      "value": "戦闘データを記録"
    },
    {
      "key": "entry.General.RecordCombatData.description",
      "value": "Modのバランス調整に役立てるため、詳細な戦闘データをお使いのPCに保存します。ポーズ中または拠点でエクスポートキー(既定はF10)を押すと、Mod作者に送れるファイルを作成します。ファイルには装備、戦闘統計、インストール済みModの一覧が含まれ、個人を特定できる情報は含まれません。"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.name",
      "value": "増援倍率"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.description",
      "value": "1つのレベルに送り込まれる増援の数を調整します。1でそのスタイルの標準量になります。"
    },
    {
      "key": "entry.Tuning.RestMultiplier.name",
      "value": "休息倍率"
    },
    {
      "key": "entry.Tuning.RestMultiplier.description",
      "value": "ピークの後にディレクターが手を緩める時間を調整します。値が低いほど、立て直す時間が短くなります。"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.name",
      "value": "エリート倍率"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.description",
      "value": "変異した増援が出現する確率を調整します。0にすると重装ユニットも出なくなります。これらを使わないスタイルには影響しません。"
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.name",
      "value": "ボスHP倍率"
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.description",
      "value": "すべてのボスのHPにこの倍率を掛けます。1ならボスはそのままです。次のレベルから反映されます。協力プレイではホストの値が使われます。"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.name",
      "value": "有効化オーバーレイ"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.description",
      "value": "ディレクターのデバッグオーバーレイを表示します。"
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.name",
      "value": "オーバーレイ切替キー"
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.description",
      "value": "デバッグオーバーレイの表示/非表示を切り替えるキーです。"
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.name",
      "value": "手動スポーンキー"
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.description",
      "value": "テスト用に敵を1体スポーンします。デバッグオーバーレイの表示中のみ機能します。"
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.name",
      "value": "スポーン判定をログ出力"
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.description",
      "value": "ディレクターの判定をBepInExログへ出力します。診断用のみで、スポーン動作には影響しません。"
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.name",
      "value": "戦闘データエクスポートキー"
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.description",
      "value": "記録した戦闘データをエクスポートするキーです。ポーズ中または拠点で機能します。"
    },
