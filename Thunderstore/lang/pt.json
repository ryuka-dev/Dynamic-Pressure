    {
      "key": "plugin.name",
      "value": "Pressão dinâmica"
    },
    {
      "key": "plugin.description",
      "value": "Adds adaptive enemy pressure and optional dynamic spawning."
    },
    {
      "key": "section.General",
      "value": "Geral"
    },
    {
      "key": "section.Tuning",
      "value": "Ajustes"
    },
    {
      "key": "section.Debug Overlay",
      "value": "Sobreposição de depuração"
    },
    {
      "key": "entry.General.EnableMod.name",
      "value": "Enable Mod"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "Ativa ou desativa a Pressão dinâmica."
    },
    {
      "key": "entry.General.PressureStyle.name",
      "value": "Pressure Style"
    },
    {
      "key": "entry.General.PressureStyle.description",
      "value": "O quanto o diretor pressiona. Estilos mais altos enviam reforços com mais frequência e introduzem inimigos mais fortes mais cedo."
    },
    {
      "key": "value.General.PressureStyle.Light",
      "value": "Leve"
    },
    {
      "key": "value.General.PressureStyle.Heavy",
      "value": "Pesado"
    },
    {
      "key": "value.General.PressureStyle.Nightmare",
      "value": "Pesadelo"
    },
    {
      "key": "entry.General.SpawnPosition.name",
      "value": "Posição de spawn"
    },
    {
      "key": "entry.General.SpawnPosition.description",
      "value": "Onde os reforços aparecem. Equilibrado: principalmente à frente e dos lados, raramente atrás. À frente: nunca atrás de você. Qualquer lugar: em qualquer direção, e podem aparecer à plena vista."
    },
    {
      "key": "value.General.SpawnPosition.Balanced",
      "value": "Equilibrado"
    },
    {
      "key": "value.General.SpawnPosition.Ahead",
      "value": "À frente"
    },
    {
      "key": "value.General.SpawnPosition.Anywhere",
      "value": "Qualquer lugar"
    },
    {
      "key": "entry.General.RecordCombatData.name",
      "value": "Registrar dados de combate"
    },
    {
      "key": "entry.General.RecordCombatData.description",
      "value": "Salva dados de combate detalhados no seu computador para ajudar a balancear o mod. Pressione a tecla de exportação (F10 por padrão) com o jogo pausado ou na base para criar um arquivo que você pode enviar ao autor do mod. Ele contém seu equipamento, suas estatísticas de combate e a lista de mods instalados, e nada que identifique você."
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.name",
      "value": "Multiplicador de reforços"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.description",
      "value": "Ajusta quantos reforços um nível pode receber. 1 é a quantidade normal do estilo."
    },
    {
      "key": "entry.Tuning.RestMultiplier.name",
      "value": "Multiplicador de descanso"
    },
    {
      "key": "entry.Tuning.RestMultiplier.description",
      "value": "Ajusta por quanto tempo o diretor alivia a pressão após um pico. Valores menores deixam menos tempo para se recuperar."
    },
    {
      "key": "entry.Tuning.EliteMultiplier.name",
      "value": "Multiplicador de elites"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.description",
      "value": "Ajusta a chance de reforços mutantes. 0 também remove as unidades pesadas. Não tem efeito em estilos que não os utilizam."
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.name",
      "value": "Enable Overlay"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.description",
      "value": "Mostra a sobreposição de depuração do diretor."
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.name",
      "value": "Overlay Toggle Key"
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.description",
      "value": "Tecla que mostra ou oculta a sobreposição de depuração."
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.name",
      "value": "Manual Spawn Key"
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.description",
      "value": "Faz surgir um inimigo para testes. Só funciona enquanto a sobreposição de depuração estiver visível."
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.name",
      "value": "Registrar decisões de spawn"
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.description",
      "value": "Escreve as decisões do diretor no log do BepInEx. Apenas diagnóstico; não afeta o spawn."
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.name",
