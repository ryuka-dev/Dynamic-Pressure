      "key": "entry.General.EnableMod.name",
      "value": "Enable Mod"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "Włącza lub wyłącza Dynamiczną presję."
    },
    {
      "key": "entry.General.PressureStyle.name",
      "value": "Pressure Style"
    },
    {
      "key": "entry.General.PressureStyle.description",
      "value": "Jak mocno naciska reżyser. Wyższe style częściej wysyłają posiłki i wcześniej wprowadzają silniejszych wrogów."
    },
    {
      "key": "value.General.PressureStyle.Light",
      "value": "Lekki"
    },
    {
      "key": "value.General.PressureStyle.Heavy",
      "value": "Ciężki"
    },
    {
      "key": "value.General.PressureStyle.Nightmare",
      "value": "Koszmar"
    },
    {
      "key": "entry.General.SpawnPosition.name",
      "value": "Pozycja spawnu"
    },
    {
      "key": "entry.General.SpawnPosition.description",
      "value": "Gdzie pojawiają się posiłki. Zrównoważona: głównie z przodu i po bokach, rzadko z tyłu. Z przodu: nigdy za tobą. Gdziekolwiek: z dowolnego kierunku, także na widoku."
    },
    {
      "key": "value.General.SpawnPosition.Balanced",
      "value": "Zrównoważona"
    },
    {
      "key": "value.General.SpawnPosition.Ahead",
      "value": "Z przodu"
    },
    {
      "key": "value.General.SpawnPosition.Anywhere",
      "value": "Gdziekolwiek"
    },
    {
      "key": "entry.General.RecordCombatData.name",
      "value": "Rejestruj dane walki"
    },
    {
      "key": "entry.General.RecordCombatData.description",
      "value": "Zapisuje szczegółowe dane walki na twoim komputerze, aby pomóc w balansowaniu moda. Naciśnij klawisz eksportu (domyślnie F10) podczas pauzy lub w bazie, aby utworzyć plik, który możesz wysłać autorowi moda. Zawiera twój ekwipunek, statystyki walki i listę zainstalowanych modów, ale nic, co mogłoby cię zidentyfikować."
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.name",
      "value": "Mnożnik posiłków"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.description",
      "value": "Skaluje liczbę posiłków, które może otrzymać poziom. 1 to normalna ilość dla danego stylu."
    },
    {
      "key": "entry.Tuning.RestMultiplier.name",
      "value": "Mnożnik odpoczynku"
    },
    {
      "key": "entry.Tuning.RestMultiplier.description",
      "value": "Skaluje, jak długo reżyser odpuszcza po szczycie. Niższe wartości oznaczają mniej czasu na regenerację."
    },
    {
      "key": "entry.Tuning.EliteMultiplier.name",
      "value": "Mnożnik elit"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.description",
      "value": "Skaluje szansę na zmutowane posiłki. 0 usuwa także ciężkie jednostki. Nie ma wpływu na style, które ich nie używają."
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.name",
      "value": "Mnożnik zdrowia bossów"
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.description",
      "value": "Mnoży zdrowie wszystkich bossów. 1 pozostawia bossów bez zmian. Działa od następnego poziomu. W kooperacji używana jest wartość hosta."
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.name",
      "value": "Enable Overlay"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.description",
      "value": "Pokazuje nakładkę debugowania reżysera."
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.name",
      "value": "Overlay Toggle Key"
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.description",
      "value": "Klawisz pokazujący lub ukrywający nakładkę debugowania."
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.name",
      "value": "Manual Spawn Key"
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.description",
      "value": "Spawnuje jednego wroga do testów. Działa tylko, gdy nakładka debugowania jest widoczna."
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.name",
      "value": "Loguj decyzje o spawnie"
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.description",
      "value": "Zapisuje decyzje reżysera do logu BepInEx. Tylko diagnostyka; nie wpływa na spawn."
    },
    {
