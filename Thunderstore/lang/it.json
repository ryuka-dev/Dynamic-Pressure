      "key": "section.General",
      "value": "Generale"
    },
    {
      "key": "section.Tuning",
      "value": "Regolazioni"
    },
    {
      "key": "section.Debug Overlay",
      "value": "Overlay di debug"
    },
    {
      "key": "entry.General.EnableMod.name",
      "value": "Enable Mod"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "Attiva o disattiva la Pressione dinamica."
    },
    {
      "key": "entry.General.PressureStyle.name",
      "value": "Pressure Style"
    },
    {
      "key": "entry.General.PressureStyle.description",
      "value": "Quanto spinge il regista. Gli stili più alti mandano rinforzi più spesso e introducono prima nemici più duri."
    },
    {
      "key": "value.General.PressureStyle.Light",
      "value": "Leggero"
    },
    {
      "key": "value.General.PressureStyle.Heavy",
      "value": "Pesante"
    },
    {
      "key": "value.General.PressureStyle.Nightmare",
      "value": "Incubo"
    },
    {
      "key": "entry.General.SpawnPosition.name",
      "value": "Posizione di spawn"
    },
    {
      "key": "entry.General.SpawnPosition.description",
      "value": "Dove compaiono i rinforzi. Bilanciato: per lo più davanti e ai lati, raramente alle spalle. Davanti: mai alle tue spalle. Ovunque: in qualsiasi direzione, e possono comparire in piena vista."
    },
    {
      "key": "value.General.SpawnPosition.Balanced",
      "value": "Bilanciato"
    },
    {
      "key": "value.General.SpawnPosition.Ahead",
      "value": "Davanti"
    },
    {
      "key": "value.General.SpawnPosition.Anywhere",
      "value": "Ovunque"
    },
    {
      "key": "entry.General.RecordCombatData.name",
      "value": "Registra dati di combattimento"
    },
    {
      "key": "entry.General.RecordCombatData.description",
      "value": "Salva dati di combattimento dettagliati sul tuo computer per aiutare a bilanciare la mod. Premi il tasto di esportazione (F10 per impostazione predefinita) mentre il gioco è in pausa o alla base per creare un file da inviare all'autore della mod. Contiene il tuo equipaggiamento, le statistiche di combattimento e l'elenco delle mod installate, e nulla che possa identificarti."
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.name",
      "value": "Moltiplicatore rinforzi"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.description",
      "value": "Regola quanti rinforzi può ricevere un livello. 1 è la quantità normale dello stile."
    },
    {
      "key": "entry.Tuning.RestMultiplier.name",
      "value": "Moltiplicatore riposo"
    },
    {
      "key": "entry.Tuning.RestMultiplier.description",
      "value": "Regola per quanto tempo il regista allenta la pressione dopo un picco. Valori più bassi lasciano meno tempo per riprendersi."
    },
    {
      "key": "entry.Tuning.EliteMultiplier.name",
      "value": "Moltiplicatore élite"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.description",
      "value": "Regola la probabilità di rinforzi mutati. 0 rimuove anche le unità pesanti. Non ha effetto sugli stili che non li utilizzano."
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.name",
      "value": "Moltiplicatore salute boss"
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.description",
      "value": "Moltiplica la salute di tutti i boss. 1 lascia i boss invariati. Ha effetto dal livello successivo. In cooperativa si usa il valore dell'host."
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.name",
      "value": "Enable Overlay"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.description",
      "value": "Mostra l'overlay di debug del regista."
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.name",
      "value": "Overlay Toggle Key"
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.description",
      "value": "Tasto che mostra o nasconde l'overlay di debug."
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.name",
      "value": "Manual Spawn Key"
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.description",
      "value": "Genera un nemico per i test. Funziona solo mentre l'overlay di debug è visibile."
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.name",
      "value": "Registra decisioni di spawn"
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.description",
      "value": "Scrive le decisioni del regista nel log di BepInEx. Solo diagnostica; non influisce sullo spawn."
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.name",
      "value": "Tasto di esportazione dati di combattimento"
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.description",
      "value": "Tasto che esporta i dati di combattimento registrati. Funziona mentre il gioco è in pausa o alla base."
    },
