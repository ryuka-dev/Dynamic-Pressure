{
  "entries": [
    {
      "key": "plugin.name",
      "value": "Pression dynamique"
    },
    {
      "key": "plugin.description",
      "value": "Adds adaptive enemy pressure and optional dynamic spawning."
    },
    {
      "key": "section.General",
      "value": "Général"
    },
    {
      "key": "section.Tuning",
      "value": "Réglages"
    },
    {
      "key": "section.Debug Overlay",
      "value": "Superposition de débogage"
    },
    {
      "key": "entry.General.EnableMod.name",
      "value": "Enable Mod"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "Active ou désactive la Pression dynamique."
    },
    {
      "key": "entry.General.PressureStyle.name",
      "value": "Pressure Style"
    },
    {
      "key": "entry.General.PressureStyle.description",
      "value": "Intensité de la pression exercée par le directeur. Les styles plus élevés envoient des renforts plus souvent et introduisent plus tôt des ennemis plus coriaces."
    },
    {
      "key": "value.General.PressureStyle.Light",
      "value": "Léger"
    },
    {
      "key": "value.General.PressureStyle.Heavy",
      "value": "Lourd"
    },
    {
      "key": "value.General.PressureStyle.Nightmare",
      "value": "Cauchemar"
    },
    {
      "key": "entry.General.SpawnPosition.name",
      "value": "Position d'apparition"
    },
    {
      "key": "entry.General.SpawnPosition.description",
      "value": "Où apparaissent les renforts. Équilibré : surtout devant et sur les côtés, rarement derrière. Devant : jamais derrière vous. Partout : dans toutes les directions, et ils peuvent apparaître sous vos yeux."
    },
    {
      "key": "value.General.SpawnPosition.Balanced",
      "value": "Équilibré"
    },
    {
      "key": "value.General.SpawnPosition.Ahead",
      "value": "Devant"
    },
    {
      "key": "value.General.SpawnPosition.Anywhere",
      "value": "Partout"
    },
    {
      "key": "entry.General.RecordCombatData.name",
      "value": "Enregistrer les données de combat"
    },
    {
      "key": "entry.General.RecordCombatData.description",
      "value": "Enregistre des données de combat détaillées sur votre ordinateur pour aider à équilibrer le mod. Appuyez sur la touche d'exportation (F10 par défaut) pendant une pause ou à la base pour créer un fichier que vous pouvez envoyer à l'auteur du mod. Il contient votre équipement, vos statistiques de combat et la liste de vos mods installés, et rien qui permette de vous identifier."
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.name",
      "value": "Multiplicateur de renforts"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.description",
      "value": "Ajuste le nombre de renforts qu'un niveau peut recevoir. 1 correspond à la quantité normale du style."
    },
    {
      "key": "entry.Tuning.RestMultiplier.name",
      "value": "Multiplicateur de repos"
    },
    {
      "key": "entry.Tuning.RestMultiplier.description",
      "value": "Ajuste la durée pendant laquelle le directeur relâche la pression après un pic. Des valeurs plus basses laissent moins de temps pour récupérer."
    },
    {
      "key": "entry.Tuning.EliteMultiplier.name",
      "value": "Multiplicateur d'élites"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.description",
      "value": "Ajuste la probabilité de renforts mutés. 0 supprime aussi les unités lourdes. Sans effet sur les styles qui ne les utilisent pas."
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.name",
      "value": "Multiplicateur de PV des boss"
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.description",
      "value": "Multiplie les points de vie de tous les boss. 1 laisse les boss tels quels. Prend effet au niveau suivant. En coop, la valeur de l'hôte est utilisée."
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.name",
      "value": "Enable Overlay"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.description",
      "value": "Affiche la superposition de débogage du directeur."
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.name",
      "value": "Overlay Toggle Key"
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.description",
      "value": "Touche qui affiche ou masque la superposition de débogage."
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.name",
      "value": "Manual Spawn Key"
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.description",
      "value": "Fait apparaître un ennemi pour les tests. Ne fonctionne que lorsque la superposition de débogage est affichée."
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.name",
      "value": "Journaliser les décisions d'apparition"
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.description",
      "value": "Écrit les décisions du directeur dans le journal BepInEx. Diagnostic uniquement ; n'affecte pas les apparitions."
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.name",
      "value": "Touche d'exportation des données de combat"
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.description",
      "value": "Touche qui exporte les données de combat enregistrées. Fonctionne pendant une pause ou à la base."
    },
