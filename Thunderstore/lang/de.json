    {
      "key": "plugin.name",
      "value": "Dynamischer Druck"
    },
    {
      "key": "plugin.description",
      "value": "Adds adaptive enemy pressure and optional dynamic spawning."
    },
    {
      "key": "section.General",
      "value": "Allgemein"
    },
    {
      "key": "section.Tuning",
      "value": "Feinabstimmung"
    },
    {
      "key": "section.Debug Overlay",
      "value": "Debug-Overlay"
    },
    {
      "key": "entry.General.EnableMod.name",
      "value": "Enable Mod"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "Schaltet den Dynamischen Druck ein oder aus."
    },
    {
      "key": "entry.General.PressureStyle.name",
      "value": "Pressure Style"
    },
    {
      "key": "entry.General.PressureStyle.description",
      "value": "Wie stark der Regisseur Druck macht. Höhere Stile schicken öfter Verstärkung und bringen früher härtere Gegner ins Spiel."
    },
    {
      "key": "value.General.PressureStyle.Light",
      "value": "Leicht"
    },
    {
      "key": "value.General.PressureStyle.Heavy",
      "value": "Schwer"
    },
    {
      "key": "value.General.PressureStyle.Nightmare",
      "value": "Albtraum"
    },
    {
      "key": "entry.General.SpawnPosition.name",
      "value": "Spawn-Position"
    },
    {
      "key": "entry.General.SpawnPosition.description",
      "value": "Wo Verstärkung erscheint. Ausgewogen: meist vorne und seitlich, selten hinten. Voraus: nie hinter dir. Überall: aus jeder Richtung, auch direkt vor deinen Augen."
    },
    {
      "key": "value.General.SpawnPosition.Balanced",
      "value": "Ausgewogen"
    },
    {
      "key": "value.General.SpawnPosition.Ahead",
      "value": "Voraus"
    },
    {
      "key": "value.General.SpawnPosition.Anywhere",
      "value": "Überall"
    },
    {
      "key": "entry.General.RecordCombatData.name",
      "value": "Kampfdaten aufzeichnen"
    },
    {
      "key": "entry.General.RecordCombatData.description",
      "value": "Speichert detaillierte Kampfdaten auf deinem Computer, um beim Balancing der Mod zu helfen. Drücke die Export-Taste (standardmäßig F10), während das Spiel pausiert ist oder du im Hub bist, um eine Datei zu erstellen, die du an den Mod-Autor senden kannst. Sie enthält deine Ausrüstung, Kampfstatistiken und die Liste deiner installierten Mods, aber nichts, was dich identifiziert."
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.name",
      "value": "Verstärkungs-Multiplikator"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.description",
      "value": "Skaliert, wie viel Verstärkung ein Level erhalten kann. 1 ist die normale Menge des Stils."
    },
    {
      "key": "entry.Tuning.RestMultiplier.name",
      "value": "Ruhe-Multiplikator"
    },
    {
      "key": "entry.Tuning.RestMultiplier.description",
      "value": "Skaliert, wie lange sich der Regisseur nach einem Höhepunkt zurückhält. Niedrigere Werte lassen weniger Zeit zur Erholung."
    },
    {
      "key": "entry.Tuning.EliteMultiplier.name",
      "value": "Elite-Multiplikator"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.description",
      "value": "Skaliert die Chance auf mutierte Verstärkung. 0 entfernt außerdem schwere Einheiten. Hat keine Wirkung auf Stile, die sie nicht verwenden."
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.name",
      "value": "Boss-Lebenspunkte-Multiplikator"
    },
    {
      "key": "entry.Tuning.BossHealthMultiplier.description",
      "value": "Multipliziert die Lebenspunkte aller Bosse. 1 lässt Bosse unverändert. Wirkt ab dem nächsten Level. Im Koop gilt der Wert des Hosts."
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.name",
      "value": "Enable Overlay"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.description",
      "value": "Zeigt das Debug-Overlay des Regisseurs an."
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.name",
      "value": "Overlay Toggle Key"
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.description",
