      "value": "Felsökningsöverlägg"
    },
    {
      "key": "entry.General.EnableMod.name",
      "value": "Enable Mod"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "Slår på eller av Dynamiskt tryck."
    },
    {
      "key": "entry.General.PressureStyle.name",
      "value": "Pressure Style"
    },
    {
      "key": "entry.General.PressureStyle.description",
      "value": "Hur hårt regissören pressar. Högre stilar skickar förstärkningar oftare och introducerar tuffare fiender tidigare."
    },
    {
      "key": "value.General.PressureStyle.Light",
      "value": "Lätt"
    },
    {
      "key": "value.General.PressureStyle.Heavy",
      "value": "Tung"
    },
    {
      "key": "value.General.PressureStyle.Nightmare",
      "value": "Mardröm"
    },
    {
      "key": "entry.General.SpawnPosition.name",
      "value": "Spawnposition"
    },
    {
      "key": "entry.General.SpawnPosition.description",
      "value": "Var förstärkningar dyker upp. Balanserad: mest framför och vid sidorna, sällan bakom. Framför: aldrig bakom dig. Var som helst: alla riktningar, och de kan dyka upp fullt synligt."
    },
    {
      "key": "value.General.SpawnPosition.Balanced",
      "value": "Balanserad"
    },
    {
      "key": "value.General.SpawnPosition.Ahead",
      "value": "Framför"
    },
    {
      "key": "value.General.SpawnPosition.Anywhere",
      "value": "Var som helst"
    },
    {
      "key": "entry.General.RecordCombatData.name",
      "value": "Spela in stridsdata"
    },
    {
      "key": "entry.General.RecordCombatData.description",
      "value": "Sparar detaljerad stridsdata på din dator för att hjälpa till att balansera modden. Tryck på exporttangenten (F10 som standard) när spelet är pausat eller när du är i basen för att skapa en fil som du kan skicka till modskaparen. Filen innehåller din utrustning, stridsstatistik och lista över installerade moddar, och inget som kan identifiera dig."
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.name",
      "value": "Förstärkningsmultiplikator"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.description",
      "value": "Skalar hur många förstärkningar en nivå kan få. 1 är stilens normala mängd."
    },
    {
      "key": "entry.Tuning.RestMultiplier.name",
      "value": "Vilomultiplikator"
    },
    {
      "key": "entry.Tuning.RestMultiplier.description",
      "value": "Skalar hur länge regissören drar sig tillbaka efter en topp. Lägre värden ger mindre tid att återhämta sig."
    },
    {
      "key": "entry.Tuning.EliteMultiplier.name",
      "value": "Elitmultiplikator"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.description",
      "value": "Skalar chansen för muterade förstärkningar. 0 tar även bort tunga enheter. Har ingen effekt på stilar som inte använder dem."
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.name",
      "value": "Enable Overlay"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.description",
      "value": "Visar regissörens felsökningsöverlägg."
    },
    {
