{
  "entries": [
    {
      "key": "plugin.name",
      "value": "Presión dinámica"
    },
    {
      "key": "plugin.description",
      "value": "Adds adaptive enemy pressure and optional dynamic spawning."
    },
    {
      "key": "section.General",
      "value": "General"
    },
    {
      "key": "section.Tuning",
      "value": "Ajustes"
    },
    {
      "key": "section.Debug Overlay",
      "value": "Superposición de depuración"
    },
    {
      "key": "entry.General.EnableMod.name",
      "value": "Enable Mod"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "Activa o desactiva la Presión dinámica."
    },
    {
      "key": "entry.General.PressureStyle.name",
      "value": "Pressure Style"
    },
    {
      "key": "entry.General.PressureStyle.description",
      "value": "Cuánta presión ejerce el director. Los estilos más altos envían refuerzos con más frecuencia e introducen antes enemigos más duros."
    },
    {
      "key": "value.General.PressureStyle.Light",
      "value": "Ligero"
    },
    {
      "key": "value.General.PressureStyle.Heavy",
      "value": "Pesado"
    },
    {
      "key": "value.General.PressureStyle.Nightmare",
      "value": "Pesadilla"
    },
    {
      "key": "entry.General.SpawnPosition.name",
      "value": "Posición de aparición"
    },
    {
      "key": "entry.General.SpawnPosition.description",
      "value": "Dónde aparecen los refuerzos. Equilibrado: sobre todo delante y a los lados, rara vez detrás. Delante: nunca detrás de ti. En cualquier lugar: en cualquier dirección, y pueden aparecer a plena vista."
    },
    {
      "key": "value.General.SpawnPosition.Balanced",
      "value": "Equilibrado"
    },
    {
      "key": "value.General.SpawnPosition.Ahead",
      "value": "Delante"
    },
    {
      "key": "value.General.SpawnPosition.Anywhere",
      "value": "En cualquier lugar"
    },
    {
      "key": "entry.General.RecordCombatData.name",
      "value": "Registrar datos de combate"
    },
    {
      "key": "entry.General.RecordCombatData.description",
      "value": "Guarda datos de combate detallados en tu ordenador para ayudar a equilibrar el mod. Pulsa la tecla de exportación (F10 por defecto) con el juego en pausa o en la base para crear un archivo que puedes enviar al autor del mod. Contiene tu equipo, tus estadísticas de combate y la lista de mods instalados, y nada que te identifique."
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.name",
      "value": "Multiplicador de refuerzos"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.description",
      "value": "Ajusta cuántos refuerzos puede recibir un nivel. 1 es la cantidad normal del estilo."
    },
    {
      "key": "entry.Tuning.RestMultiplier.name",
      "value": "Multiplicador de descanso"
    },
    {
      "key": "entry.Tuning.RestMultiplier.description",
      "value": "Ajusta cuánto tiempo afloja el director tras un pico. Los valores más bajos dejan menos tiempo para recuperarse."
    },
    {
      "key": "entry.Tuning.EliteMultiplier.name",
      "value": "Multiplicador de élites"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.description",
      "value": "Ajusta la probabilidad de refuerzos mutados. 0 también elimina las unidades pesadas. No tiene efecto en los estilos que no los usan."
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.name",
      "value": "Enable Overlay"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.description",
      "value": "Muestra la superposición de depuración del director."
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.name",
      "value": "Overlay Toggle Key"
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.description",
      "value": "Tecla que muestra u oculta la superposición de depuración."
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.name",
      "value": "Manual Spawn Key"
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.description",
      "value": "Hace aparecer un enemigo para pruebas. Solo funciona mientras se muestra la superposición de depuración."
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.name",
      "value": "Registrar decisiones de aparición"
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.description",
      "value": "Escribe las decisiones del director en el registro de BepInEx. Solo diagnóstico; no afecta a las apariciones."
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.name",
      "value": "Tecla de exportación de datos de combate"
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.description",
      "value": "Tecla que exporta los datos de combate registrados. Funciona con el juego en pausa o en la base."
    },
