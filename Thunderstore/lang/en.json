{
  "entries": [
    {
      "key": "plugin.name",
      "value": "Dynamic Pressure"
    },
    {
      "key": "plugin.description",
      "value": "Adds adaptive enemy pressure and optional dynamic spawning."
    },
    {
      "key": "section.General",
      "value": "General"
    },
    {
      "key": "section.Tuning",
      "value": "Tuning"
    },
    {
      "key": "section.Debug Overlay",
      "value": "Debug Overlay"
    },
    {
      "key": "entry.General.EnableMod.name",
      "value": "Enable Mod"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "Turns Dynamic Pressure on or off."
    },
    {
      "key": "entry.General.PressureStyle.name",
      "value": "Pressure Style"
    },
    {
      "key": "entry.General.PressureStyle.description",
      "value": "How hard the director pushes. Higher styles send reinforcements more often and introduce tougher enemies earlier."
    },
    {
      "key": "value.General.PressureStyle.Light",
      "value": "Light"
    },
    {
      "key": "value.General.PressureStyle.Heavy",
      "value": "Heavy"
    },
    {
      "key": "value.General.PressureStyle.Nightmare",
      "value": "Nightmare"
    },
    {
      "key": "entry.General.SpawnPosition.name",
      "value": "Spawn Position"
    },
    {
      "key": "entry.General.SpawnPosition.description",
      "value": "Where reinforcements appear. Balanced: mostly ahead and to the sides, rarely behind. Ahead: never behind you. Anywhere: any direction, and they can appear in plain sight."
    },
    {
      "key": "value.General.SpawnPosition.Balanced",
      "value": "Balanced"
    },
    {
      "key": "value.General.SpawnPosition.Ahead",
      "value": "Ahead"
    },
    {
      "key": "value.General.SpawnPosition.Anywhere",
      "value": "Anywhere"
    },
    {
      "key": "entry.General.RecordCombatData.name",
      "value": "Record Combat Data"
    },
    {
      "key": "entry.General.RecordCombatData.description",
      "value": "Saves detailed combat data on your computer to help balance the mod. Press the export key (F10 by default) while paused or in the hub to create a file you can send to the mod author. It contains your gear, combat statistics and installed mod list, and nothing that identifies you."
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.name",
      "value": "Reinforcement Multiplier"
    },
    {
      "key": "entry.Tuning.ReinforcementMultiplier.description",
      "value": "Scales how many reinforcements a level can receive. 1 is the style's normal amount."
    },
    {
      "key": "entry.Tuning.RestMultiplier.name",
      "value": "Rest Multiplier"
    },
    {
      "key": "entry.Tuning.RestMultiplier.description",
      "value": "Scales how long the director backs off after a peak. Lower values mean less time to recover."
    },
    {
      "key": "entry.Tuning.EliteMultiplier.name",
      "value": "Elite Multiplier"
    },
    {
      "key": "entry.Tuning.EliteMultiplier.description",
      "value": "Scales the chance of mutated reinforcements. 0 also removes heavy units. Has no effect on styles that do not use them."
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.name",
      "value": "Enable Overlay"
    },
    {
      "key": "entry.Debug Overlay.EnableOverlay.description",
      "value": "Show the director's debug overlay."
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.name",
      "value": "Overlay Toggle Key"
    },
    {
      "key": "entry.Debug Overlay.OverlayToggleKey.description",
      "value": "Key that shows or hides the debug overlay."
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.name",
      "value": "Manual Spawn Key"
    },
    {
      "key": "entry.Debug Overlay.ManualSpawnKey.description",
      "value": "Spawns one enemy for testing. Only works while the debug overlay is showing."
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.name",
      "value": "Log Spawn Decisions"
    },
    {
      "key": "entry.Debug Overlay.LogSpawnDecisions.description",
      "value": "Write the director's decisions to the BepInEx log. Diagnostics only; does not affect spawning."
    },
    {
      "key": "entry.Debug Overlay.ExportCombatDataKey.name",
      "value": "Export Combat Data Key"
    },
